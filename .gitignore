# Build products
*.o
*.obj
*.out
*.exe
*.d
*.gch
*.pch
*.su
*.dSYM/

# The assembler binary
/assembler
assembler.exe

# Files the assembler generates when it is run in the repository root.
# The expected outputs of the test suite live under tests/ and are tracked
# (see the end of this file).
/*.am
/*.ob
/*.ent
/*.ext
!/formal_tester.ob

# Scratch directories of the test runner (tests/run_tests.sh)
/tests/out/

# Temporary test files in the repository root
/*.expected
test_output*
temp_*
test_files_temp/
output_temp/
scratch/

# Intermediate directories
build/
bin/
obj/
debug/
release/

# Backup and editor swap files
*~
*.bak
*.tmp
*.swp
*.swo
*.backup

# IDEs and editors
.vscode/
.idea/
*.code-workspace
*.sublime-*

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary Makefile copies
Makefile_*
makefile_*
*.mk.tmp

# Debugging and profiling output
core
core.*
vgcore.*
*.log
*.trace
debug.txt
output.txt

# Files left behind by merges and patches
*.orig
*.rej

# Archives
*.zip
*.tar
*.tar.gz
*.rar

# Private settings and keys
config.local
.env
*.key
*.pem

# Course materials: not ours to publish
docs/booklet.pdf
docs/booklet.txt
docs/Task_14.docx
docs/forum.txt
docs/corrections.pdf
docs/corrections.txt
docs/Task_14.pdf

# The test cases are tracked in full, whatever their names or extensions.
# These lines must stay at the end of the file.
!/tests/valid/**
!/tests/errors/**
!/tests/cli/**
